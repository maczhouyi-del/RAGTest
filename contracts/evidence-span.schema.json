{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ragsystem.local/contracts/evidence-span.v0.schema.json",
  "title": "EvidenceSpan v0 (P3 reserved; P0 must not claim this is implemented)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_id", "doc_version_id", "file_sha256",
    "parse_run_id", "source_anchor_id", "page_number", "element_id",
    "quote_text", "quote_sha256", "clean_text_offsets", "location_confidence"
  ],
  "properties": {
    "schema_version": {"const": "0.1-draft"},
    "evidence_id": {"type": "string", "minLength": 1},
    "doc_version_id": {"type": "string", "minLength": 1},
    "file_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "parse_run_id": {"type": "string", "minLength": 1},
    "source_anchor_id": {"type": "string", "minLength": 1},
    "page_number": {"type": "integer", "minimum": 1},
    "element_id": {"type": "string", "minLength": 1},
    "quote_text": {"type": "string", "minLength": 1},
    "quote_sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
    "clean_text_offsets": {
      "type": "object", "additionalProperties": false,
      "required": ["start", "end"],
      "properties": {
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 0}
      }
    },
    "location_confidence": {"enum": ["high", "medium", "low", "unknown"]},
    "extraction_note": {"type": ["string", "null"]},
    "table_row_id": {"type": ["string", "null"]},
    "table_column_id": {"type": ["string", "null"]}
  },
  "description": "Schema checks shapes only. Runtime must validate referential integrity, quote hash, offsets, source support, table row/column and PDF version. Semantic verification and human review are separate entities."
}
